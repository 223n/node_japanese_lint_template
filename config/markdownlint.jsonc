// Markdown の検査規則。
// markdownlint-cli2 と、VS Code 拡張（DavidAnson.vscode-markdownlint）の両方がこの形を読む。
//
// 既定を土台にし、日本語の技術文書と噛み合わない規則だけを切ってある。
// 切った規則には、なぜ切ったかを必ず書く。理由の書けない除外を増やさないためである。
{
  "default": true,

  // MD013 行の長さ。
  // 一文一行で書くと、一文が80文字を超えることは普通にある。
  // 表の列幅もエディタが自動でそろえるため、行は長くなる。
  // 日本語では文字数と表示幅も一致しないため、行長で測ること自体が噛み合わない。
  "MD013": false,

  // MD024 同じ見出しの重複。
  // 番号や識別子で区別する見出し（「3.9. 一覧（S09）」と「3.14. 一覧（S15）」）がある。
  // 兄弟の見出しどうしだけを見る設定にする。
  "MD024": { "siblings_only": true },

  // MD029 順序付きリストの番号。
  // すべて「1.」で書く。順番を入れ替えても差分が1行で済むためである。
  "MD029": { "style": "one" },

  // MD046 コードブロックの書き方。フェンスに統一する。
  "MD046": { "style": "fenced" },

  // MD048 コードフェンスの記号。バッククォートに統一する。
  "MD048": { "style": "backtick" },

  // MD049 強調の記号。アンダースコアではなくアスタリスクに統一する。
  "MD049": { "style": "asterisk" },

  // MD050 太字の記号。同上。
  "MD050": { "style": "asterisk" },

  // MD060 表の記号の揃え方。
  // 「compact」（記号の左右に空白1つ）か「aligned」（列幅をそろえる）のどちらかに統一を求める。
  //
  // 日本語の表は全角と半角が混ざり、エディタによって「そろっている」の意味が変わる。
  // 有効にすると、表を1行足すたびに列幅の付け直しを迫られ、差分が本文以外で膨らむ。
  "MD060": false
}
